{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Interactive line chart showing API across stations with up to three selectable stations and year range filter, including annotations for maximum API per station.",
  "width": 800,
  "height": 400,
  "padding": {"top": 0, "bottom": 5, "left": 160, "right": 10},
  
  "data": {
    "url": "https://raw.githubusercontent.com/william22288/fit3179-data-viz-2/refs/heads/main/data/2017_to_2022_Daily_API_across_Different_Stations(long).csv"
  },
  "params": [
    {
      "name": "Station1",
      "value": "Kota Bharu",
      "bind": {
        "input": "select",
        "options": [
          "None", "Alor Gajah", "Alor Setar", "Balik Pulau", "Balok Baru Kuantan",
          "Bandaraya Melaka", "Banting", "Batu Muda", "Batu Pahat", "Besut",
          "Bintulu", "Bukit Rambai", "Cheras", "Indera Mahkota Kuantan",
          "Jerantut", "Kangar", "Kapit", "Kemaman", "Keningau", "Kimanis",
          "Klang", "Kluang", "Kota Bharu", "Kota Kinabalu", "Kota Tinggi",
          "Kuala Selangor", "Kuala Terengganu", "Kuching", "Kulim", "Labuan",
          "Langkawi", "Larkin", "Limbang", "Minden", "Miri", "Muar", "Mukah",
          "Nilai", "Paka", "Pasir Gudang", "Pegoh Ipoh", "Pengerang",
          "Petaling Jaya", "Port Dickson", "Putrajaya", "Rompin", "Samalaju",
          "Samarahan", "Sandakan", "Sarikei", "Seberang Jaya", "Seberang Perai",
          "Segamat", "Seremban", "Seri Manjung", "Shah Alam", "Sibu",
          "Sri Aman", "Sungai Petani", "Taiping", "Tanah Merah", "Tangkak",
          "Tanjung Malim", "Tasek Ipoh", "Tawau", "Temerloh"
        ],
        "name": "Station 1: "
      }
    },
    {
      "name": "Station2",
      "value": "None",
      "bind": {
        "input": "select",
        "options": [
          "None", "Alor Gajah", "Alor Setar", "Balik Pulau", "Balok Baru Kuantan",
          "Bandaraya Melaka", "Banting", "Batu Muda", "Batu Pahat", "Besut",
          "Bintulu", "Bukit Rambai", "Cheras", "Indera Mahkota Kuantan",
          "Jerantut", "Kangar", "Kapit", "Kemaman", "Keningau", "Kimanis",
          "Klang", "Kluang", "Kota Bharu", "Kota Kinabalu", "Kota Tinggi",
          "Kuala Selangor", "Kuala Terengganu", "Kuching", "Kulim", "Labuan",
          "Langkawi", "Larkin", "Limbang", "Minden", "Miri", "Muar", "Mukah",
          "Nilai", "Paka", "Pasir Gudang", "Pegoh Ipoh", "Pengerang",
          "Petaling Jaya", "Port Dickson", "Putrajaya", "Rompin", "Samalaju",
          "Samarahan", "Sandakan", "Sarikei", "Seberang Jaya", "Seberang Perai",
          "Segamat", "Seremban", "Seri Manjung", "Shah Alam", "Sibu",
          "Sri Aman", "Sungai Petani", "Taiping", "Tanah Merah", "Tangkak",
          "Tanjung Malim", "Tasek Ipoh", "Tawau", "Temerloh"
        ],
        "name": "Station 2: "
      }
    },
    {
      "name": "Station3",
      "value": "None",
      "bind": {
        "input": "select",
        "options": [
          "None", "Alor Gajah", "Alor Setar", "Balik Pulau", "Balok Baru Kuantan",
          "Bandaraya Melaka", "Banting", "Batu Muda", "Batu Pahat", "Besut",
          "Bintulu", "Bukit Rambai", "Cheras", "Indera Mahkota Kuantan",
          "Jerantut", "Kangar", "Kapit", "Kemaman", "Keningau", "Kimanis",
          "Klang", "Kluang", "Kota Bharu", "Kota Kinabalu", "Kota Tinggi",
          "Kuala Selangor", "Kuala Terengganu", "Kuching", "Kulim", "Labuan",
          "Langkawi", "Larkin", "Limbang", "Minden", "Miri", "Muar", "Mukah",
          "Nilai", "Paka", "Pasir Gudang", "Pegoh Ipoh", "Pengerang",
          "Petaling Jaya", "Port Dickson", "Putrajaya", "Rompin", "Samalaju",
          "Samarahan", "Sandakan", "Sarikei", "Seberang Jaya", "Seberang Perai",
          "Segamat", "Seremban", "Seri Manjung", "Shah Alam", "Sibu",
          "Sri Aman", "Sungai Petani", "Taiping", "Tanah Merah", "Tangkak",
          "Tanjung Malim", "Tasek Ipoh", "Tawau", "Temerloh"
        ],
        "name": "Station 3: "
      }
    },
    {
      "name": "MinYear",
      "value": 2017,
      "bind": {
        "input": "range",
        "min": 2017,
        "max": 2022,
        "step": 1,
        "name": "Year to Begin:"
      }
    },
    {
      "name": "MaxYear",
      "value": 2017,
      "bind": {
        "input": "range",
        "min": 2017,
        "max": 2022,
        "step": 1,
        "name": "Year to End:"
      }
    }
  ],
  "transform": [
    {
      "fold": [
        "Alor Gajah", "Alor Setar", "Balik Pulau", "Balok Baru Kuantan",
        "Bandaraya Melaka", "Banting", "Batu Muda", "Batu Pahat", "Besut",
        "Bintulu", "Bukit Rambai", "Cheras", "Indera Mahkota Kuantan",
        "Jerantut", "Kangar", "Kapit", "Kemaman", "Keningau", "Kimanis",
        "Klang", "Kluang", "Kota Bharu", "Kota Kinabalu", "Kota Tinggi",
        "Kuala Selangor", "Kuala Terengganu", "Kuching", "Kulim", "Labuan",
        "Langkawi", "Larkin", "Limbang", "Minden", "Miri", "Muar", "Mukah",
        "Nilai", "Paka", "Pasir Gudang", "Pegoh Ipoh", "Pengerang",
        "Petaling Jaya", "Port Dickson", "Putrajaya", "Rompin", "Samalaju",
        "Samarahan", "Sandakan", "Sarikei", "Seberang Jaya", "Seberang Perai",
        "Segamat", "Seremban", "Seri Manjung", "Shah Alam", "Sibu",
        "Sri Aman", "Sungai Petani", "Taiping", "Tanah Merah", "Tangkak",
        "Tanjung Malim", "Tasek Ipoh", "Tawau", "Temerloh"
      ],
      "as": ["Region", "API"]
    },
    {"calculate": "toNumber(datum.API)", "as": "API"},
    {"calculate": "toDate(datum.Time)", "as": "Date"},
    {"calculate": "year(datum.Date)", "as": "Year"},
    {
      "filter": "(Station1 != 'None' && datum.Region == Station1) || (Station2 != 'None' && datum.Region == Station2) || (Station3 != 'None' && datum.Region == Station3)"
    },
    {"filter": "datum.Year >= MinYear && datum.Year <= MaxYear"}
  ],
  "layer": [
    {
      "mark": {"type": "line", "point": false},
      "encoding": {
        "x": {"field": "Date", "type": "temporal", "title": "Date", "axis": {"grid": false}},
        "y": {
          "field": "API",
          "type": "quantitative",
          "title": "Air Pollution Index (API)",
          "scale": {"zero": false}
        },
        "color": {
          "field": "Region",
          "type": "nominal",
          "title": "Stations",
          "scale": {"scheme": "tableau10"},
          "legend": {
            "labelLimit": 50000,
            "orient": "bottom",
            "titleLimit": 50000,
            "padding": 30,
            "direction": "vertical"
          }
        },
        "tooltip": [
          {"field": "Region", "title": "Station"},
          {
            "field": "Date",
            "type": "temporal",
            "title": "Date",
            "format": "%B %d, %Y"
          },
          {"field": "API", "type": "quantitative"}
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {"op": "max", "field": "API", "as": "maxAPI"},
            {"op": "argmax", "field": "API", "as": "maxPoint"}
          ],
          "groupby": ["Region"]
        },
        {
          "calculate": "datum.Region + ' Maximum API: ' + format(datum.maxAPI, '.0f')",
          "as": "maxLabel"
        }
      ],
      "mark": {"type": "text", "align": "right", "dx": 5, "dy": -5, "color": "gray"},
      "encoding": {
        "x": {"field": "maxPoint.Date", "type": "temporal"},
        "y": {"field": "maxPoint.API", "type": "quantitative"},
        "text": {"field": "maxLabel"},
        "detail": {"field": "Region"}
      }
    }
  ],
  "title": {
    "text": "Daily Air Pollution Index (API) Across up to 3 Selected Stations (2017-2022)",
    "font": "serif",
    "fontSize": 20,
    "fontWeight": "bold",
    "anchor": "middle",
    "color": "#000"
  },
  "config": {
    "line": {"point": false},
    "view": {"stroke": "transparent"},
    "padding": {"top": 30}
  }
}
