{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Comparison of maximum API among selected stations in 2020",
  "width": 500,
  "height": 400,
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/william22288/fit3179-data-viz-2/refs/heads/main/data/Yearly_Max_Min_API_across_Different_Stations.csv"
      },
      "transform": [
        {"filter": "datum.Year == 2020"},
        {
          "filter": "indexof(['Bandaraya Melaka, Melaka', 'Cheras, Kuala Lumpur', 'Kota Kinabalu, Sabah', 'Kuching, Sarawak', 'Larkin, Johor Bahru', 'Miri, Sarawak', 'Seberang Jaya, Pulau Pinang'], trim(datum['Selected Stations'])) >= 0"
        }
      ],
      "mark": {
        "type": "bar"
      },
      "encoding": {
        "x": {
          "field": "Selected Stations",
          "type": "nominal",
          "axis": {"labelAngle": -20, "title": "Station"}
        },
        "y": {
          "field": "Maximum",
          "type": "quantitative",
          "title": "Air Pollution Index (API)"
        },
        "color": {
          "condition": [
            {
              "test": "datum['Selected Stations'] === 'Cheras, Kuala Lumpur'",
              "value": "#8c564b"
            },
            {
              "test": "datum['Selected Stations'] === 'Kota Kinabalu, Sabah '",
              "value": "#c5b0d5"
            }
          ],
          "value": "gray"
        },
        "tooltip": [
          {"field": "Selected Stations","title":"Station", "type": "nominal"},
          {"field": "Maximum", "title":"Maximum API", "type": "quantitative"}
        ]
      }
    },
    {
      "data": {
        "values": [{"dummy": 1}]
      },
      "mark": {
        "type": "rect",
        "fill": "#f0f0f0",
        "stroke": "#ccc",
        "cornerRadius": 4
      },
      "encoding": {
        "x": {"value":55},
        "y": {"value": 0},
        "x2": {"value": 315},
        "y2": {"value": 20}
      }
    },
    {
      "data": {
        "values": [
          {
            "text": ["Cheras has the highest maximum API of 132."]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12
        
      },
      "encoding": {
        "x": {"value": 65},
        "y": {"value": 5},
        "text": {"field": "text"}
      }
    },
    {
      "data": {
        "values": [{"dummy": 1}]
      },
      "mark": {
        "type": "rect",
        "fill": "#f0f0f0",
        "stroke": "#ccc",
        "cornerRadius": 4
      },
      "encoding": {
        "x": {"value":150},
        "y": {"value": 120},
        "x2": {"value": 285},
        "y2": {"value": 165}
      }
    },
    {
      "data": {
        "values": [
          {
            "text": ["Kota Kinabalu has the", "lowest maximum API", "of 77."]
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 12
        
      },
      "encoding": {
        "x": {"value": 155},
        "y": {"value": 125},
        "text": {"field": "text"}
      }
    }
  ],
  "title": {
    "text": ["Maximum Air Pollution Index (API) Across Selected Monitoring Stations", "in 2020"],
    "anchor": "middle",
    "fontSize": 20,
    "fontWeight": "bold",
    "font": "serif"
  }
}