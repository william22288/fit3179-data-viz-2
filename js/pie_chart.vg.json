{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Percentage of API stations by state (labels outside slices)",
  "width": 700,
  "height": 420,
  "data": {
    "url": "https://raw.githubusercontent.com/william22288/fit3179-data-viz-2/main/data/Stations_Information.csv"
  },
  "transform": [
    {
      "aggregate": [{"op": "count", "as": "StationCount"}],
      "groupby": ["state"]
    },
    {
      "joinaggregate": [{"op": "sum", "field": "StationCount", "as": "Total"}]
    },
    {
      "stack": "StationCount",
      "groupby": [],
      
      "sort": [{"field": "state", "order": "ascending"}], 
      "as": ["start", "end"]
    },
    {
      "calculate": "(datum.start + datum.end) / 2",
      "as": "midpoint"
    },
    {
      "calculate": "datum.StationCount / datum.Total",
      "as": "Percentage"
    },
    {
      "calculate": "datum.midpoint / datum.Total",
      "as": "midpoint_normalized"
    }
  ],
  "layer": [
    {
      "mark": {"type": "arc", "outerRadius": 225},
      "encoding": {
        
        "theta": {"field": "StationCount", "type": "quantitative"},
        "color": {
          "field": "state",
          "type": "nominal",
          "scale": {"scheme": "tableau20"},
          "title": "State",
          "legend": {
            "orient": "right",
            "titleAnchor": "start",
            "padding": 20,
            "offset": 20
          }
        },
        "tooltip": [
          {"field": "state","title":"State", "type": "nominal"},
          {"field": "StationCount", "title": "Number of Stations"},
          {
            "field": "Percentage",
            "type": "quantitative",
            "format": ".1%",
            "title": "Percentage"
          }
        ]
      }
    },
    {
      "mark": {"type": "text", "radius": 240, "fill": "black"},
      "encoding": {
        "theta": {"field": "midpoint", "type": "quantitative", "stack": null},
        "text": {
          "field": "Percentage",
          "type": "quantitative",
          "format": ".1%"
        },
        "align": {
          "condition": {"test": "datum.midpoint_normalized > 0.5", "value": "left"},
          "value": "right"
        },
        "dx": {
          "condition": {"test": "datum.midpoint_normalized > 0.5", "value": 6},
          "value": -6
        },
        "baseline": {"value": "middle"}
      }
    }
  ],
  "title": {
    
    "text": "Distribution of Air Pollution Index (API) Monitoring Stations Across Malaysian States",
    "anchor": "middle",
    "fontSize": 16,
    "offset": 25 
    
  },
  "view": {"stroke": null}
}