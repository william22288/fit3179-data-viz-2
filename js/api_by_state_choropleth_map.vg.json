{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Average Air Pollution Index (API) by State in Malaysia (2017–2022)",
    "fontSize": 20,
    "fontWeight": "bold",
    "font": "serif",
    "anchor": "middle",
    "dy": -5
  },
  "width": 780,
  "height": 550,
  "padding": {"top": 0, "bottom": 10, "left": 10, "right": 100},
  
  "params": [
    {
      "name": "center_to",
      "value": [110, 4],
      "bind": {
        "input": "select",
        "options": [
          [110, 4],
          [102.0, 4.0],
          [114.0, 4.5]
        ],
        "labels": ["Whole Malaysia","Peninsular Malaysia", "East Malaysia"],
        "name": "Map Centre: "
      }
    },
    {
      "name": "zoom",
      "value": 2000,
      "bind": {
        "input": "range",
        "min": 500,
        "max": 5000,
        "step": 100,
        "name": "Zoom: "
      }
    },
    {
      "name": "YearSelector",
      "value": 2017,
      "bind": {
        "input": "range",
        "min": 2017,
        "max": 2022,
        "step": 1,
        "name": "Selected Year: "
      }
    }
  ],
  "projection": {
    "type": "mercator",
    "center": {"expr": "center_to"},
    "scale": {"expr": "zoom"}
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/FIT3179/Vega-Lite/main/7_others/oceans.topojson",
        "format": { "type": "topojson", "feature": "oceans" }
      },
      "mark": { "type": "geoshape", "fill": "#cce7ff" }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/william22288/fit3179-data-viz-2/refs/heads/main/js/ne_10m_graticules_5.topojson",
        "format": { "type": "topojson", "feature": "ne_10m_graticules_5" }
      },
      "mark": { "type": "geoshape", "fill": null, "stroke": "#ddd" }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/william22288/fit3179-data-viz-2/refs/heads/main/data/state_yearly_average_API_2017_to_2022.csv",
        "format": {"type": "csv"}
      },
      "transform": [
        {"filter": "datum.Year == YearSelector"},
        {
          "lookup": "State",
          "from": {
            "data": {
              "url": "https://raw.githubusercontent.com/william22288/fit3179-data-viz-2/refs/heads/main/js/malaysia_boundaries.topojson",
              "format": {"type": "topojson", "feature": "MYSADM1gbOpen"}
            },
            "key": "properties.shapeName",
            "fields": ["properties", "type", "geometry"]
          }
        }
      ],
      "mark": {"type": "geoshape"},
      "encoding": {
        "color": {
          "field": "State_Average_API",
          "type": "quantitative",
          "bin": {"maxbins": 5},
          "scale": {"scheme": "reds"},
          "legend": {
            "title": "Air Pollution Index",
            "orient": "right",
            "direction": "vertical",
            "labelFontSize": 10,
            "titleFontSize": 11,
            "offset": 5
          }
        },
        "tooltip": [
          {"field": "State", "title": "State"},
          {"field": "Year", "title": "Year"},
          {"field": "State_Average_API", "title": "Average API", "format": ".2f"}
        ]
      }
    }
  ],
  "config": {
    "title": {"anchor": "middle"},
    "legend": {"labelLimit": 100, "padding": 0},
    "view": {"stroke": "transparent"}
  }
}
